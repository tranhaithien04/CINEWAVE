{
  "expo": {
    "name": "CineWave",
    "slug": "cinewave-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06070d"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CineWave cần quyền truy cập ảnh để bạn có thể tải lên ảnh CCCD xác minh độ tuổi.",
          "cameraPermission": "CineWave cần quyền sử dụng máy ảnh để chụp trực tiếp thẻ CCCD."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06070d",
          "imageWidth": 200
        }
      ]
    ]
  }
}
