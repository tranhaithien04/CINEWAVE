# Copy to deploy/.env on VPS — không commit file .env thật

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cinewave
JWT_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# URL web production (Vercel hoặc custom domain)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com
# Nếu dùng app.yourdomain.com + api.yourdomain.com:
# COOKIE_DOMAIN=.yourdomain.com

AI_SERVICE_KEY=
HOLD_TTL_SECONDS=270
UPLOAD_TMP_DIR=./uploads/tmp

OMDB_API_KEY=
TMDB_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CINEWAVE <no-reply@yourdomain.com>

PAYMENT_PROVIDER=SEPAY
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=MBBank
SEPAY_BANK_LABEL=MB Bank
SEPAY_ACCOUNT_NAME=CINEWAVE
SEPAY_QR_BASE=https://qr.sepay.vn/img
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback
