# Env trên Render Dashboard (cinewave-api) — không commit giá trị thật

NODE_ENV=production
PORT=4000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/cinewave
JWT_SECRET=long-random-string
JWT_REFRESH_SECRET=another-long-random-string

# Frontend Vercel
NEXT_PUBLIC_APP_URL=https://cinewave-tt.vercel.app
CORS_ORIGINS=https://cinewave-tt.vercel.app
COOKIE_SAMESITE=none

# URL YOLO service trên Render (sau khi deploy server-YOLO-CINEWAVE)
AI_SERVICE_URL=https://cinewave-yolo.onrender.com
AI_SERVICE_KEY=

HOLD_TTL_SECONDS=270
UPLOAD_TMP_DIR=./uploads/tmp

OMDB_API_KEY=
TMDB_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CINEWAVE <no-reply@cinewave.vn>

PAYMENT_PROVIDER=SEPAY
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=
SEPAY_BANK_LABEL=
SEPAY_ACCOUNT_NAME=
SEPAY_QR_BASE=https://qr.sepay.vn/img
SEPAY_WEBHOOK_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Đổi sau khi có URL Render thật, ví dụ:
GOOGLE_CALLBACK_URL=https://cinewave-api.onrender.com/auth/google/callback
